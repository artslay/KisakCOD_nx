     pub fn as_mut_slice(&mut self) -> &mut [LowerBoundedU32<MIN_U32>] {
         if self.last < Self::MAX_LEN_U32 {
             &mut self.arr[0..(self.last as usize)]
         } else {
             // SAFETY:
             //
             // We only ever place a length or a LowerBoundedU32 in self.last.
             // So if it's not a valid length, it must be a valid
             // LowerBoundedU32.
+            //
+            // This slice covers the complete #[repr(C)] object, including
+            // the encoded final element in last. Use the whole-object pointer
+            // so the mutable slice does not extend a field-derived pointer
+            // beyond the arr field it originally referenced.
             debug_assert!(self.last >= MIN_U32);
             unsafe {
                 std::slice::from_raw_parts_mut(
-                    &mut self.arr as *mut _ as *mut LowerBoundedU32<MIN_U32>,
+                    self as *mut Self as *mut LowerBoundedU32<MIN_U32>,
                     Self::MAX_LEN,
                 )
             }
         }
