+    #[test]
+    fn test_u32arr_full_mut_slice_updates_encoded_tail() {
+        type TestArray = LowerBoundedU32Array<5, 3>;
+        let mut arr: TestArray = [
+            LowerBoundedU32::new(10_u32).unwrap(),
+            LowerBoundedU32::new(15_u32).unwrap(),
+            LowerBoundedU32::new(17_u32).unwrap(),
+            LowerBoundedU32::new(23_u32).unwrap(),
+        ]
+        .into();
+
+        let replacement = LowerBoundedU32::new(55_u32).unwrap();
+        arr.as_mut_slice()[3] = replacement;
+
+        assert_eq!(arr.as_slice()[3], replacement);
+        assert_eq!(arr.pop(), Some(replacement));
+        assert_eq!(arr.len(), 3);
+    }
